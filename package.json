{
  "name": "@qtsurfer/engine-ts",
  "version": "0.0.1",
  "private": true,
  "description": "QTSurfer Engine — TypeScript monorepo",
  "license": "AGPL-3.0-only OR LicenseRef-Wualabs-Commercial",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/check-license-files.mjs && pnpm -r test",
